{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "insurance_sales_dialogue_dataset turn",
  "type": "object",
  "required": [
    "conversation_id",
    "turn_id",
    "speaker",
    "text",
    "source_type",
    "source_dataset",
    "license_reference",
    "customer_intent",
    "customer_emotion",
    "customer_profile_id",
    "customer_need",
    "budget",
    "existing_coverage",
    "coverage_gap",
    "objection_type",
    "objection_severity",
    "sales_stage",
    "seller_action",
    "seller_strategy",
    "yes_yes",
    "yes_yes_stage",
    "customer_reaction",
    "objection_status",
    "purchase_intent",
    "purchase_intent_change",
    "outcome"
  ],
  "properties": {
    "conversation_id": { "type": "string" },
    "turn_id": { "type": "integer", "minimum": 0 },
    "speaker": { "enum": ["customer", "agent"] },
    "text": { "type": "string", "minLength": 1 },
    "source_type": { "enum": ["public", "manual_annotation", "synthetic", "simulated", "derived"] },
    "source_dataset": { "type": "string" },
    "license_reference": { "type": "string" },
    "scenario_id": { "type": "string" },
    "dataset_version": { "type": "string" },
    "annotation_source": { "type": "string" },
    "purchase_intent_change": { "type": "number", "minimum": -1, "maximum": 1 },
    "objection_severity": { "type": "number", "minimum": 0, "maximum": 1 },
    "yes_yes": { "type": "boolean" },
    "purchase_intent": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
